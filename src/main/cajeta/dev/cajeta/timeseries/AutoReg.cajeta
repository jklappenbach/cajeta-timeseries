package dev.cajeta.timeseries;

import cajeta.math.Tensor;

/**
 * `AutoReg` (spec §8.1–§8.3), matching statsmodels
 * `statsmodels.tsa.ar_model.AutoReg`: least squares on the lag matrix,
 * with either lags `1..p` or an EXPLICIT lag list — `[1, 4]` puts only
 * those two lags in the model, never silently filling 2 and 3 (§8.2).
 * Trend: `"n"`, `"c"` (default), `"ct"` — the time-trend column is the
 * 1-based position in the ORIGINAL series, statsmodels' convention.
 *
 * Parameters are readable with their standard errors (§8.1);
 * `llf`/`aic`/`bic`/`hqic` use statsmodels' definitions
 * (`σ² = SSR/nobs`, `k = params + 1` counting the variance).
 * Forecasting is the dynamic recursion; intervals use the AR ψ-weights.
 */
public final class AutoReg implements Forecaster {

    int64[] lags;        // strictly increasing, ≥ 1
    int64 maxlag;
    String trend;
    int64 ktrend;

    float64[] beta;      // [ktrend + nlags]
    float64[] se;
    float64 s2;          // SSR / nobs
    float64 ll;
    int64 nUsed;
    float64[] hist;      // last maxlag values, chronological
    int64 histBase;      // 1-based time position of hist[0]
    int64 lastIndex;
    int64 step;
    boolean fitted;

    /** AutoReg over lags `1..p`, constant trend. */
    public AutoReg(int64 p) {
        if (p < 1) {
            throw heap TsException("AutoReg: p must be >= 1 (got " + p + ")");
        }
        int64[] ls = heap int64[p];
        int64 i = 0;
        while (i < p) { ls[i] = i + 1; i = i + 1; }
        this.init(#ls);
        return;
    }

    /** AutoReg over an EXPLICIT lag list (§8.2), constant trend. */
    public AutoReg(#int64[] lagList) {
        this.init(#lagList);
        return;
    }

    void init(#int64[] ls) {
        int64 k = (int64) ls.count();
        if (k < 1) {
            throw heap TsException("AutoReg: at least one lag is required");
        }
        int64 i = 0;
        int64 prev = 0;
        while (i < k) {
            if (ls[i] <= prev) {
                throw heap TsException("AutoReg: lags must be strictly "
                    + "increasing and >= 1");
            }
            prev = ls[i];
            i = i + 1;
        }
        this.lags #= ls;
        this.maxlag = prev;
        this.trend = "c";
        this.ktrend = 1;
        this.fitted = false;
        return;
    }

    /** Trend: `"n"`, `"c"`, or `"ct"` (§8.3). Call before fit. */
    public void setTrend(String trend) {
        if (trend.equals("n")) { this.ktrend = 0; }
        else if (trend.equals("c")) { this.ktrend = 1; }
        else if (trend.equals("ct")) { this.ktrend = 2; }
        else {
            throw heap TsException("AutoReg: trend must be \"n\", \"c\", or "
                + "\"ct\" (got \"" + trend + "\")");
        }
        this.trend = trend;
        return;
    }

    public void fit(Series s) {
        int64 n = s.count();
        int64 k = (int64) this.lags.count();
        int64 cols = this.ktrend + k;
        int64 rows = n - this.maxlag;
        if (rows <= cols) {
            throw heap TsException("AutoReg: " + n + " observations cannot "
                + "fit maxlag " + this.maxlag + " with " + cols
                + " coefficients");
        }
        if (s.hasMissing()) {
            throw heap TsException("AutoReg: the series has "
                + s.missingCount() + " missing value(s)");
        }
        float64[] xf = heap float64[rows * cols];
        float64[] yv = heap float64[rows];
        int64 t = this.maxlag;
        while (t < n) {
            int64 r = t - this.maxlag;
            int64 c = 0;
            if (this.ktrend >= 1) { xf[r * cols] = 1.0; c = 1; }
            if (this.ktrend >= 2) {
                xf[r * cols + 1] = (float64) (t + 1);   // 1-based position
                c = 2;
            }
            int64 j = 0;
            while (j < k) {
                xf[r * cols + c + j] = s.get(t - this.lags[j]);
                j = j + 1;
            }
            yv[r] = s.get(t);
            t = t + 1;
        }
        Ols o #= Ols.fit(xf, rows, cols, yv);
        float64[] b = heap float64[cols];
        float64[] e = heap float64[cols];
        // statsmodels AutoReg reports MLE standard errors (σ² = SSR/n);
        // Ols computes the df-adjusted ones — rescale.
        float64 mle = Math.sqrt((float64) (rows - cols) / (float64) rows);
        int64 j2 = 0;
        while (j2 < cols) {
            b[j2] = o.beta[j2];
            e[j2] = o.beta[j2] / o.tvals[j2] * mle;
            j2 = j2 + 1;
        }
        this.beta #= b;
        this.se #= e;
        this.nUsed = rows;
        this.s2 = o.ssr / (float64) rows;
        this.ll = -0.5 * (float64) rows
            * (Math.log(2.0 * 3.141592653589793 * this.s2) + 1.0);

        float64[] hh = heap float64[this.maxlag];
        int64 i2 = 0;
        while (i2 < this.maxlag) {
            hh[i2] = s.get(n - this.maxlag + i2);
            i2 = i2 + 1;
        }
        this.hist #= hh;
        this.histBase = n - this.maxlag + 1;
        this.lastIndex = s.indexAt(n - 1);
        this.step = s.indexStep();
        this.fitted = true;
        return;
    }

    /** Coefficients: `[const?, trend?, lag coefficients…]`. */
    public #float64[] params() { return this.copy(this.beta); }

    /** Standard errors, aligned with {@link #params}. */
    public #float64[] stderr() { return this.copy(this.se); }

    /** The lag list in the model. */
    public #int64[] lagList() {
        int64 k = (int64) this.lags.count();
        int64[] out = heap int64[k];
        int64 i = 0;
        while (i < k) { out[i] = this.lags[i]; i = i + 1; }
        return #out;
    }

    public float64 llf() { this.check(); return this.ll; }

    public float64 sigma2() { this.check(); return this.s2; }

    public int64 nobs() { this.check(); return this.nUsed; }

    float64 kIc() {
        return (float64) ((int64) this.lags.count() + this.ktrend + 1);
    }

    /** Akaike (§9.5): `−2·llf + 2k`, `k` counting σ². */
    public float64 aic() { this.check(); return -2.0 * this.ll + 2.0 * this.kIc(); }

    /** Bayes: `−2·llf + k·log nobs`. */
    public float64 bic() {
        this.check();
        return -2.0 * this.ll + this.kIc() * Math.log((float64) this.nUsed);
    }

    /** Hannan-Quinn: `−2·llf + 2k·log log nobs`. */
    public float64 hqic() {
        this.check();
        return -2.0 * this.ll
            + 2.0 * this.kIc() * Math.log(Math.log((float64) this.nUsed));
    }

    public #Series forecast(int64 h) {
        ForecastResult f #= this.forecastInterval(h, 0.05);
        Series m = f.mean;
        return Series.of(m.values(), m.index());
    }

    /** Dynamic forecast with ψ-weight prediction intervals (§9.2). */
    public #ForecastResult forecastInterval(int64 h, float64 alpha) {
        this.check();
        if (h < 1) {
            throw heap TsException("AutoReg: the horizon must be >= 1 "
                + "(got " + h + ")");
        }
        int64 k = (int64) this.lags.count();
        // Extended path: history then forecasts.
        float64[] path = heap float64[this.maxlag + h];
        int64 i = 0;
        while (i < this.maxlag) { path[i] = this.hist[i]; i = i + 1; }
        int64 step2 = 0;
        while (step2 < h) {
            int64 t = this.maxlag + step2;      // position in path
            int64 tpos = this.histBase + t;     // 1-based time position
            float64 v = 0.0;
            if (this.ktrend >= 1) { v = this.beta[0]; }
            if (this.ktrend >= 2) {
                v = v + this.beta[1] * (float64) tpos;
            }
            int64 j = 0;
            while (j < k) {
                v = v + this.beta[this.ktrend + j]
                    * path[t - this.lags[j]];
                j = j + 1;
            }
            path[t] = v;
            step2 = step2 + 1;
        }
        // ψ-weights of the AR polynomial over the explicit lags.
        float64[] psi = heap float64[h];
        psi[0] = 1.0;
        int64 s3 = 1;
        while (s3 < h) {
            float64 acc = 0.0;
            int64 j = 0;
            while (j < k) {
                if (this.lags[j] <= s3) {
                    acc = acc + this.beta[this.ktrend + j]
                        * psi[s3 - this.lags[j]];
                }
                j = j + 1;
            }
            psi[s3] = acc;
            s3 = s3 + 1;
        }
        float64 z = Norm.ppf(1.0 - alpha / 2.0);
        float64[] mean = heap float64[h];
        float64[] lo = heap float64[h];
        float64[] hi = heap float64[h];
        int64[] idx = heap int64[h];
        float64 varAcc = 0.0;
        i = 0;
        while (i < h) {
            varAcc = varAcc + psi[i] * psi[i];
            float64 sd = Math.sqrt(this.s2 * varAcc);
            mean[i] = path[this.maxlag + i];
            lo[i] = mean[i] - z * sd;
            hi[i] = mean[i] + z * sd;
            idx[i] = this.lastIndex + (i + 1) * this.step;
            i = i + 1;
        }
        int64[] sh = heap int64[1]; sh[0] = h;
        Series ms #= Series.of(Tensor.of<float64>(mean, sh), idx);
        Series ls #= Series.of(Tensor.of<float64>(lo, sh), idx);
        Series hs #= Series.of(Tensor.of<float64>(hi, sh), idx);
        ForecastResult fr = heap ForecastResult(#ms, #ls, #hs, alpha);
        return #fr;
    }

    void check() {
        if (!this.fitted) {
            throw heap TsException("AutoReg: not fitted yet");
        }
        return;
    }

    #float64[] copy(float64[] a) {
        this.check();
        int64 n = (int64) a.count();
        float64[] out = heap float64[n];
        int64 i = 0;
        while (i < n) { out[i] = a[i]; i = i + 1; }
        return #out;
    }
}
