package dev.cajeta.timeseries;

import cajeta.math.Tensor;
import cajeta.math.optim.NelderMead;
import cajeta.math.optim.OptimResult;
import cajeta.math.optim.TerminationReason;

/**
 * ARIMA(p, d, q) by exact Gaussian maximum likelihood (spec §8.4–§8.8),
 * with MA(q) = ARIMA(0,0,q) and ARMA(p,q) = ARIMA(p,0,q) — one
 * implementation, as §8.5 requires. The series is differenced `d` times,
 * the ARMA likelihood is evaluated exactly by the Kalman filter
 * ({@link ArmaNll}), stationarity/invertibility are enforced through the
 * Monahan transform (§8.7), and the optimizer is **`cajeta.math.optim`'s
 * Nelder-Mead** started from Hannan-Rissanen estimates (§8's gate on
 * `stdlib-completion` U5 — no optimizer is duplicated here).
 *
 * **Non-convergence is loud** (§8.8): {@link #converged} and
 * {@link #terminationReason} surface the optimizer's verdict, `fit`
 * prints a warning, and the last iterate is reported as such — never
 * as a converged fit.
 *
 * Forecasts integrate back to the ORIGINAL scale automatically (§8.6,
 * §11.4); intervals come from the ψ-weights, cumulated `d` times.
 * Trend: `"n"` or `"c"` (the constant is the process MEAN μ,
 * statsmodels' ARIMA parameterization).
 */
public final class Arima implements Forecaster {

    int64 p;
    int64 d;
    int64 q;
    boolean withMean;

    float64 mu;
    float64[] phi;
    float64[] theta;
    float64 s2;
    float64 ll;
    int64 nUsed;
    boolean conv;
    String reason;

    float64[] ztail;     // differenced series (all of it), for recursion
    float64[] intTails;  // last value of each Δ^j y, j = 0..d-1
    int64 lastIndex;
    int64 step;
    boolean fitted;

    public Arima(int64 p, int64 d, int64 q) {
        if (p < 0 || d < 0 || q < 0 || p + q < 1) {
            throw heap TsException("Arima: orders must be >= 0 with "
                + "p + q >= 1 (got p=" + p + ", d=" + d + ", q=" + q + ")");
        }
        this.p = p;
        this.d = d;
        this.q = q;
        this.withMean = d == 0;      // statsmodels: default trend c iff d==0
        this.fitted = false;
        return;
    }

    /** Trend: `"n"` or `"c"` (§8.3). Call before fit. */
    public void setTrend(String trend) {
        if (trend.equals("n")) { this.withMean = false; }
        else if (trend.equals("c")) { this.withMean = true; }
        else {
            throw heap TsException("Arima: trend must be \"n\" or \"c\" "
                + "(got \"" + trend + "\")");
        }
        return;
    }

    public void fit(Series s) {
        if (s.hasMissing()) {
            throw heap TsException("Arima: the series has "
                + s.missingCount() + " missing value(s)");
        }
        // Difference in place, retaining the integration tails (the last
        // value of each Δʲy) BEFORE each level is consumed.
        int64 n0 = s.count();
        if (this.d >= n0) {
            throw heap TsException("Arima: d = " + this.d + " consumes the "
                + "whole series (n = " + n0 + ")");
        }
        float64[] a = heap float64[n0];
        int64 i = 0;
        while (i < n0) { a[i] = s.get(i); i = i + 1; }
        float64[] tails = heap float64[this.d + 1];
        int64 m = n0;
        int64 j = 0;
        while (j < this.d) {
            tails[j] = a[m - 1];
            i = 0;
            while (i < m - 1) { a[i] = a[i + 1] - a[i]; i = i + 1; }
            m = m - 1;
            j = j + 1;
        }
        this.intTails #= tails;
        int64 n = m;
        if (n < 10 + this.p + this.q) {
            throw heap TsException("Arima: only " + n + " observations "
                + "after differencing — too short for (p=" + this.p
                + ", q=" + this.q + ")");
        }
        float64[] z = heap float64[n];
        i = 0;
        while (i < n) { z[i] = a[i]; i = i + 1; }
        float64[] zkeep = heap float64[n];
        i = 0;
        while (i < n) { zkeep[i] = z[i]; i = i + 1; }
        this.ztail #= zkeep;
        this.nUsed = n;
        this.lastIndex = s.indexAt(s.count() - 1);
        this.step = s.indexStep();

        // Hannan-Rissanen start.
        float64[] x0 = this.hannanRissanen(z, n);

        ArmaNll nll = heap ArmaNll(#z, this.p, this.q, this.withMean);
        int64 dim = (int64) x0.count();
        int64[] xsh = heap int64[1]; xsh[0] = dim;
        Tensor<float64> x0t = Tensor.of<float64>(x0, xsh);
        OptimResult r = NelderMead.minimize(nll, x0t, (int32) 20000);

        this.mu = nll.muOf(r.x);
        this.phi #= nll.phiOf(r.x);
        this.theta #= nll.thetaOf(r.x);
        this.s2 = nll.sigma2At(r.x);
        this.ll = nll.llfAt(r.x);
        this.conv = r.converged;
        if (r.reason == TerminationReason.SIMPLEX_SIZE) {
            this.reason = "SIMPLEX_SIZE";
        } else if (r.reason == TerminationReason.MAX_ITERATIONS) {
            this.reason = "MAX_ITERATIONS";
        } else if (r.reason == TerminationReason.NONFINITE) {
            this.reason = "NONFINITE";
        } else if (r.reason == TerminationReason.STEP_SIZE) {
            this.reason = "STEP_SIZE";
        } else {
            this.reason = "GRADIENT_NORM";
        }
        if (!this.conv) {
            System.stdout.println("WARNING Arima(" + this.p + "," + this.d
                + "," + this.q + "): the optimizer did NOT converge ("
                + this.reason + " after " + (int64) r.iterations
                + " iterations) - the LAST ITERATE follows; do not treat "
                + "it as a maximum-likelihood fit");
        }
        this.fitted = true;
        return;
    }

    /** Two-stage Hannan-Rissanen initial values (§7.2.3 of the plan). */
    #float64[] hannanRissanen(float64[] z, int64 n) {
        float64 mean = 0.0;
        int64 i = 0;
        while (i < n) { mean = mean + z[i]; i = i + 1; }
        mean = mean / (float64) n;
        float64 m0 = 0.0;
        if (this.withMean) { m0 = mean; }
        float64[] zc = heap float64[n];
        i = 0;
        while (i < n) { zc[i] = z[i] - m0; i = i + 1; }

        int64 maxpq = this.p;
        if (this.q > maxpq) { maxpq = this.q; }
        float64[] phi0 = heap float64[this.p];
        float64[] th0 = heap float64[this.q];
        if (this.q == 0) {
            // Pure AR: OLS on the lags directly.
            Ols o = this.lagOls(zc, n, this.p, null, (int64) 0);
            i = 0;
            while (i < this.p) { phi0[i] = o.beta[i]; i = i + 1; }
        } else {
            // Stage 1: long AR for residuals; stage 2: OLS on lags + ê.
            int64 lag = 10 + maxpq;
            if (lag > n / 4) { lag = n / 4; }
            Ols l = this.lagOls(zc, n, lag, null, (int64) 0);
            float64[] eh = heap float64[n];
            int64 t = lag;
            while (t < n) {
                float64 fitv = 0.0;
                int64 k = 0;
                while (k < lag) {
                    fitv = fitv + l.beta[k] * zc[t - 1 - k];
                    k = k + 1;
                }
                eh[t] = zc[t] - fitv;
                t = t + 1;
            }
            Ols o = this.lagOls(zc, n, this.p, eh, this.q);
            i = 0;
            while (i < this.p) { phi0[i] = o.beta[i]; i = i + 1; }
            i = 0;
            while (i < this.q) { th0[i] = o.beta[this.p + i]; i = i + 1; }
        }
        // To the unconstrained space (θ negated: see ArmaNll.thetaOf).
        float64[] xphi = ArmaNll.unconstrain(phi0, this.p);
        i = 0;
        while (i < this.q) { th0[i] = -th0[i]; i = i + 1; }
        float64[] xth = ArmaNll.unconstrain(th0, this.q);
        int64 off = 0;
        if (this.withMean) { off = 1; }
        float64[] x0 = heap float64[off + this.p + this.q];
        if (this.withMean) { x0[0] = mean; }
        i = 0;
        while (i < this.p) { x0[off + i] = xphi[i]; i = i + 1; }
        i = 0;
        while (i < this.q) { x0[off + this.p + i] = xth[i]; i = i + 1; }
        return #x0;
    }

    /** OLS of z on its own lags 1..pl (+ lags 1..ql of e when given). */
    #Ols lagOls(float64[] z, int64 n, int64 pl, float64[] e, int64 ql) {
        int64 start = pl;
        if (ql > start) { start = ql; }
        if (e != null) {
            int64 lag = 10 + pl;
            if (ql > pl) { lag = 10 + ql; }
            // Residuals only exist from the long-AR warm-up onward.
            if (lag > n / 4) { lag = n / 4; }
            if (lag + ql > start) { start = lag + ql; }
        }
        if (start < 1) { start = 1; }
        int64 rows = n - start;
        int64 cols = pl + ql;
        if (cols == 0 || rows <= cols) {
            throw heap TsException("Arima: series too short for the "
                + "Hannan-Rissanen regression");
        }
        float64[] xf = heap float64[rows * cols];
        float64[] yv = heap float64[rows];
        int64 t = start;
        while (t < n) {
            int64 r = t - start;
            int64 k = 0;
            while (k < pl) {
                xf[r * cols + k] = z[t - 1 - k];
                k = k + 1;
            }
            k = 0;
            while (k < ql) {
                xf[r * cols + pl + k] = e[t - 1 - k];
                k = k + 1;
            }
            yv[r] = z[t];
            t = t + 1;
        }
        return Ols.fit(xf, rows, cols, yv);
    }

    /** AR coefficients φ. */
    public #float64[] arParams() { this.check(); return this.copyA(this.phi); }

    /** MA coefficients θ. */
    public #float64[] maParams() { this.check(); return this.copyA(this.theta); }

    /** The constant (process mean μ); 0 without a trend. */
    public float64 constant() { this.check(); return this.mu; }

    /** The innovation variance σ². */
    public float64 sigma2() { this.check(); return this.s2; }

    public float64 llf() { this.check(); return this.ll; }

    float64 kIc() {
        float64 k = (float64) (this.p + this.q + 1);
        if (this.withMean) { k = k + 1.0; }
        return k;
    }

    /** Akaike (§9.5). */
    public float64 aic() { this.check(); return -2.0 * this.ll + 2.0 * this.kIc(); }

    /** Bayes. */
    public float64 bic() {
        this.check();
        return -2.0 * this.ll + this.kIc() * Math.log((float64) this.nUsed);
    }

    /** Hannan-Quinn. */
    public float64 hqic() {
        this.check();
        return -2.0 * this.ll
            + 2.0 * this.kIc() * Math.log(Math.log((float64) this.nUsed));
    }

    /** True when the optimizer converged (§8.8). */
    public boolean converged() { this.check(); return this.conv; }

    /** The optimizer's termination reason, verbatim (§7.1.7). */
    public #String terminationReason() {
        this.check();
        String out = "" + this.reason;
        return #out;
    }

    public #Series forecast(int64 h) {
        ForecastResult f = this.forecastInterval(h, 0.05);
        Series m = f.mean;
        return Series.of(m.values(), m.index());
    }

    /**
     * Forecast with intervals, in the ORIGINAL scale (§8.6, §9.1–§9.2):
     * the ARMA recursion forecasts the differenced series, integration
     * restores the level, and the variance uses the ψ-weights cumulated
     * `d` times.
     */
    public #ForecastResult forecastInterval(int64 h, float64 alpha) {
        this.check();
        if (h < 1) {
            throw heap TsException("Arima: the horizon must be >= 1 (got "
                + h + ")");
        }
        int64 n = this.nUsed;
        // In-sample innovations by the conditional recursion.
        float64[] eh = heap float64[n];
        int64 t = 0;
        while (t < n) {
            float64 v = this.ztail[t] - this.mu;
            int64 i = 0;
            while (i < this.p) {
                if (t - 1 - i >= 0) {
                    v = v - this.phi[i] * (this.ztail[t - 1 - i] - this.mu);
                }
                i = i + 1;
            }
            i = 0;
            while (i < this.q) {
                if (t - 1 - i >= 0) {
                    v = v - this.theta[i] * eh[t - 1 - i];
                }
                i = i + 1;
            }
            eh[t] = v;
            t = t + 1;
        }
        // Forecast the differenced series.
        float64[] zf = heap float64[h];
        int64 s3 = 0;
        while (s3 < h) {
            float64 v = 0.0;
            int64 i = 0;
            while (i < this.p) {
                int64 pos = s3 - 1 - i;
                float64 zp;
                if (pos >= 0) { zp = zf[pos] - this.mu; }
                else { zp = this.ztail[n + pos] - this.mu; }
                v = v + this.phi[i] * zp;
                i = i + 1;
            }
            i = 0;
            while (i < this.q) {
                int64 pos = s3 - 1 - i;
                if (pos < 0) { v = v + this.theta[i] * eh[n + pos]; }
                i = i + 1;
            }
            zf[s3] = this.mu + v;
            s3 = s3 + 1;
        }
        // Integrate d times: each pass cumulates from the retained tail.
        float64[] level = heap float64[h];
        int64 i2 = 0;
        while (i2 < h) { level[i2] = zf[i2]; i2 = i2 + 1; }
        int64 j = this.d - 1;
        while (j >= 0) {
            float64 acc = this.intTails[j];
            i2 = 0;
            while (i2 < h) {
                acc = acc + level[i2];
                level[i2] = acc;
                i2 = i2 + 1;
            }
            j = j - 1;
        }
        // ψ-weights, cumulated d times for the integrated variance.
        float64[] psi = heap float64[h];
        psi[0] = 1.0;
        s3 = 1;
        while (s3 < h) {
            float64 acc = 0.0;
            if (s3 - 1 < this.q) { acc = this.theta[s3 - 1]; }
            int64 i = 0;
            while (i < this.p) {
                if (s3 - 1 - i >= 0) {
                    acc = acc + this.phi[i] * psi[s3 - 1 - i];
                }
                i = i + 1;
            }
            psi[s3] = acc;
            s3 = s3 + 1;
        }
        j = 0;
        while (j < this.d) {
            float64 acc = 0.0;
            i2 = 0;
            while (i2 < h) {
                acc = acc + psi[i2];
                psi[i2] = acc;
                i2 = i2 + 1;
            }
            j = j + 1;
        }
        float64 z = Norm.ppf(1.0 - alpha / 2.0);
        float64[] lo = heap float64[h];
        float64[] hi = heap float64[h];
        int64[] idx = heap int64[h];
        float64 varAcc = 0.0;
        i2 = 0;
        while (i2 < h) {
            varAcc = varAcc + psi[i2] * psi[i2];
            float64 sd = Math.sqrt(this.s2 * varAcc);
            lo[i2] = level[i2] - z * sd;
            hi[i2] = level[i2] + z * sd;
            idx[i2] = this.lastIndex + (i2 + 1) * this.step;
            i2 = i2 + 1;
        }
        int64[] sh = heap int64[1]; sh[0] = h;
        Series ms = Series.of(Tensor.of<float64>(level, sh), idx);
        Series ls = Series.of(Tensor.of<float64>(lo, sh), idx);
        Series hs = Series.of(Tensor.of<float64>(hi, sh), idx);
        ForecastResult fr = heap ForecastResult(#ms, #ls, #hs, alpha);
        return #fr;
    }

    void check() {
        if (!this.fitted) {
            throw heap TsException("Arima: not fitted yet");
        }
        return;
    }

    #float64[] copyA(float64[] a) {
        int64 n = (int64) a.count();
        float64[] out = heap float64[n];
        int64 i = 0;
        while (i < n) { out[i] = a[i]; i = i + 1; }
        return #out;
    }
}
