{
    // cajeta-timeseries — the statsmodels-role time-series surface for the
    // cajeta ecosystem: series representation with lag operators, classical
    // decomposition, stationarity testing (ADF + KPSS) and differencing,
    // white-noise/random-walk diagnostics, ACF/PACF with confidence bands,
    // moving averages, and the AR/MA/ARMA/ARIMA family with forecasting.
    //
    // THE PARITY ORACLE IS STATSMODELS, NOT SCIKIT-LEARN — statsmodels
    // 0.14.6 (numpy 2.5.1 / scipy 1.18.0), pinned in tools/fixtures. Every
    // numeric claim ties to a fixture computed at that pin; deliberate
    // departures live in docs/DifferencesFromStatsmodels.md.
    //
    // A LIBRARY project: no `entry-method`, so the build emits a reusable
    // `.cja` rather than an executable.
    //
    // VERSIONING — `details.version` is the SINGLE source of truth. It names
    // the built archive (`dev.cajeta.timeseries-<version>.cja`), it is what
    // CI publishes to Olla, and CI asserts a `v*` tag agrees with it.

    "details": {
        "name":               "dev.cajeta.timeseries",
        "version":            "0.1.1",
        "description":        "cajeta-timeseries — classical time series: decomposition, stationarity, correlograms, and the ARIMA family with lookahead-proof evaluation",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // Pure tensor arithmetic — no filesystem or network use in v1.
        "capabilities": [],

        // dev.cajeta.ml supplies Metrics (forecast scoring) and the
        // Predictor protocol where it genuinely fits (spec §8.9). The core
        // stdlib (cajeta.math incl. linalg/fft/stats/optim, cajeta.nucleo)
        // is built into the toolchain — not declared.
        "dependencies": {
            "dev.cajeta.ml": "0.10.0"
        },

        // The suite is driven by cajeta-unit's reflective @Test discovery;
        // run-tests.sh resolves the archive (sibling checkout, then store,
        // then a sha256-verified Olla fetch at this pin).
        "dev-dependencies": {
            "dev.cajeta.unit": "0.2.0"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        // NO `entry-method` — this is a library; the build emits a .cja.
        "build": {
            "source-root": "src/main/cajeta",
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            "description": "Build + run the library's test suite",
            "actions": [
                { "action": "exec", "command": "./run-tests.sh" }
            ]
        },

        "tour": {
            "description": "Build + run the self-checking tour",
            "actions": [
                { "action": "exec", "command": "./run-tour.sh" }
            ]
        },

        "release": {
            "description": "Release build of the .cja",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Remove build outputs",
            "actions": [
                { "action": "exec", "command": "rm -rf build" }
            ]
        }
    }
}
