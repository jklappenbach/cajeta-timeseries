package dev.cajeta.timeseries;

import cajeta.math.stats.Stats;

/**
 * The standard-normal quantile (inverse CDF) the confidence bands need —
 * `cajeta.math.stats` exposes `normalCdf` but no `ppf` (another gap
 * registered for stdlib promotion). Acklam's rational approximation
 * polished with one Halley step against the stdlib's own `normalCdf`, so
 * the pair round-trips to machine precision. PACKAGE-PRIVATE.
 */
final class Norm {

    /** Inverse standard-normal CDF at `p` ∈ (0, 1). */
    static float64 ppf(float64 p) {
        if (p <= 0.0 || p >= 1.0) {
            throw heap TsException("Norm.ppf: p must be in (0, 1) (got "
                + p + ")");
        }
        float64 x;
        if (p < 0.02425) {
            float64 q = Math.sqrt(-2.0 * Math.log(p));
            x = (((((-0.007784894002430293 * q - 0.3223964580411365) * q
                - 2.400758277161838) * q - 2.549732539343734) * q
                + 4.374664141464968) * q + 2.938163982698783)
                / ((((0.007784695709041462 * q + 0.3224671290700398) * q
                + 2.445134137142996) * q + 3.754408661907416) * q + 1.0);
        } else if (p > 1.0 - 0.02425) {
            float64 q = Math.sqrt(-2.0 * Math.log(1.0 - p));
            x = -(((((-0.007784894002430293 * q - 0.3223964580411365) * q
                - 2.400758277161838) * q - 2.549732539343734) * q
                + 4.374664141464968) * q + 2.938163982698783)
                / ((((0.007784695709041462 * q + 0.3224671290700398) * q
                + 2.445134137142996) * q + 3.754408661907416) * q + 1.0);
        } else {
            float64 q = p - 0.5;
            float64 r = q * q;
            x = (((((-39.69683028665376 * r + 220.9460984245205) * r
                - 275.9285104469687) * r + 138.3577518672690) * r
                - 30.66479806614716) * r + 2.506628277459239) * q
                / (((((-54.47609879822406 * r + 161.5858368580409) * r
                - 155.6989798598866) * r + 66.80131188771972) * r
                - 13.28068155288572) * r + 1.0);
        }
        // One Halley step against the stdlib CDF.
        float64 e = Stats.normalCdf(x) - p;
        float64 u = e * 2.5066282746310002
            * Math.exp(x * x / 2.0);
        x = x - u / (1.0 + x * u / 2.0);
        return x;
    }
}
