package dev.cajeta.timeseries.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.timeseries.Decompose;
import dev.cajeta.timeseries.Decomposition;
import dev.cajeta.timeseries.Series;
import dev.cajeta.timeseries.TsException;

/**
 * ml-timeseries U2 — classical decomposition against statsmodels 0.14.6
 * `seasonal_decompose`: additive and multiplicative parity including the
 * NaN endpoint policy of the centred moving average (2.1.5), the odd-
 * period filter, recombination round trips (2.1.3), and loud rejection of
 * impossible configurations (2.1.4, spec §3.3–§3.4).
 */
public class DecomposeTest {

    public DecomposeTest() { return; }

    static void assertComponentsMatch(Decomposition d, String prefix) {
        Tensor<float64> wantT = Fx.load(prefix + "_trend");
        Tensor<float64> wantS = Fx.load(prefix + "_seasonal");
        Tensor<float64> wantR = Fx.load(prefix + "_resid");
        int64 n = wantT.shapeAt(0);
        Assert.equals(d.trend.count(), n);
        int64 i = 0;
        while (i < n) {
            Assert.isTrue(Fx.agree(d.trend.get(i), wantT.flatGet(i), 0.0000000001));
            Assert.isTrue(Fx.agree(d.seasonal.get(i), wantS.flatGet(i), 0.0000000001));
            Assert.isTrue(Fx.agree(d.resid.get(i), wantR.flatGet(i), 0.0000000001));
            i = i + 1;
        }
        return;
    }

    // 2.1.1 + 2.1.5 — additive decomposition matches statsmodels, NaN
    // endpoints included (even period 12: the half-weight filter, 6
    // missing on each side of the trend).
    @Test
    public void additiveMatchesStatsmodels() {
        Series s = Series.of(Fx.load("ts_decomp_add_observed"));
        Decomposition d = Decompose.additive(s, (int64) 12);
        DecomposeTest.assertComponentsMatch(d, "ts_decomp_add");
        // The endpoint policy is explicit: period/2 missing each side.
        Assert.equals(d.trend.missingCount(), (int64) 12);
        Assert.isTrue(d.trend.isMissing((int64) 0));
        Assert.isTrue(d.trend.isMissing((int64) 5));
        Assert.isTrue(!d.trend.isMissing((int64) 6));
        Assert.isTrue(!d.trend.isMissing((int64) 41));
        Assert.isTrue(d.trend.isMissing((int64) 42));
        return;
    }

    // 2.1.1 + 2.1.2 — multiplicative decomposition matches statsmodels and
    // is genuinely distinct from the additive model.
    @Test
    public void multiplicativeMatchesStatsmodelsAndDiffersFromAdditive() {
        Series s = Series.of(Fx.load("ts_decomp_mult_observed"));
        Decomposition m = Decompose.multiplicative(s, (int64) 12);
        DecomposeTest.assertComponentsMatch(m, "ts_decomp_mult");
        // Multiplicative seasonal factors hover around 1; the additive
        // seasonal of the same series hovers around 0 — distinct models.
        Decomposition a = Decompose.additive(s, (int64) 12);
        Assert.isTrue(Fx.close(DecomposeTest.meanAbs(m.seasonal), 1.0, 0.5));
        Assert.isTrue(DecomposeTest.meanAbs(a.seasonal) > 1.0);
        return;
    }

    static float64 meanAbs(Series s) {
        float64 acc = 0.0;
        int64 i = 0;
        while (i < s.count()) {
            float64 v = s.get(i);
            if (v < 0.0) { v = -v; }
            acc = acc + v;
            i = i + 1;
        }
        return acc / (float64) s.count();
    }

    // 2.1.5 — the odd-period filter (plain ones/period window): 3 missing
    // on each side for period 7, matching statsmodels exactly.
    @Test
    public void oddPeriodEndpointsMatch() {
        Series s = Series.of(Fx.load("ts_decomp_odd_observed"));
        Decomposition d = Decompose.additive(s, (int64) 7);
        DecomposeTest.assertComponentsMatch(d, "ts_decomp_odd");
        Assert.equals(d.trend.missingCount(), (int64) 6);
        Assert.isTrue(d.trend.isMissing((int64) 2));
        Assert.isTrue(!d.trend.isMissing((int64) 3));
        return;
    }

    // 2.1.3 — components recombine to the original, additively or
    // multiplicatively as chosen, wherever the trend is defined.
    @Test
    public void componentsRecombine() {
        Series sa = Series.of(Fx.load("ts_decomp_add_observed"));
        Decomposition da = Decompose.additive(sa, (int64) 12);
        int64 i = 0;
        while (i < sa.count()) {
            if (!da.trend.isMissing(i)) {
                float64 back = da.trend.get(i) + da.seasonal.get(i) + da.resid.get(i);
                Assert.isTrue(Fx.close(back, sa.get(i), 0.000000001));
            }
            i = i + 1;
        }
        Series sm = Series.of(Fx.load("ts_decomp_mult_observed"));
        Decomposition dm = Decompose.multiplicative(sm, (int64) 12);
        i = 0;
        while (i < sm.count()) {
            if (!dm.trend.isMissing(i)) {
                float64 back = dm.trend.get(i) * dm.seasonal.get(i) * dm.resid.get(i);
                Assert.isTrue(Fx.close(back, sm.get(i), 0.000000001));
            }
            i = i + 1;
        }
        return;
    }

    // 2.1.4 + §3.3/§3.4 — impossible configurations are loud: a period
    // longer than the series, fewer than two complete cycles, a period
    // below 2, and a multiplicative model over non-positive values.
    @Test
    public void impossibleConfigurationsAreLoud() {
        Series s = Series.of(Fx.load("ts_decomp_add_observed"));   // n = 48
        boolean threw = false;
        try {
            Decomposition d = Decompose.additive(s, (int64) 100);
        } catch (TsException ex) { threw = true; }
        Assert.isTrue(threw);

        threw = false;
        try {
            Decomposition d2 = Decompose.additive(s, (int64) 25);  // < 2 cycles
        } catch (TsException ex) { threw = true; }
        Assert.isTrue(threw);

        threw = false;
        try {
            Decomposition d3 = Decompose.additive(s, (int64) 1);
        } catch (TsException ex) { threw = true; }
        Assert.isTrue(threw);

        float64[] neg = heap float64[24];
        int64 i = 0;
        while (i < 24) { neg[i] = (float64) i - 5.0; i = i + 1; }
        int64[] sh = heap int64[1]; sh[0] = 24;
        Series sn = Series.of(Tensor.of<float64>(neg, sh));
        threw = false;
        try {
            Decomposition d4 = Decompose.multiplicative(sn, (int64) 12);
        } catch (TsException ex) { threw = true; }
        Assert.isTrue(threw);
        return;
    }
}
