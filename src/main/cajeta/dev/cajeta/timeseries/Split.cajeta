package dev.cajeta.timeseries;

import cajeta.math.Tensor;

/**
 * Series splitting (spec §2.5, §11.5): **chronological is the only
 * split offered, and that absence is the feature.** A shuffled or
 * random train/test split on a time series lets every fold see the
 * future — the score looks excellent and the model is worthless.
 * `dev.cajeta.ml`'s `trainTestSplit` remains reachable for tabular
 * data, but nothing in THIS library converts a `Series` into a shape it
 * accepts without going through {@link Series#values} deliberately.
 * There is no `shuffle` parameter here to set, mis-set, or default
 * wrongly — do not add one.
 */
public final class Split {

    /**
     * Chronological split: the first `1 − testFraction` of the series
     * trains, the remainder tests. Both keep their original index, so
     * the boundary is auditable.
     */
    public static #TrainTest chronological(Series s, float64 testFraction) {
        if (testFraction <= 0.0 || testFraction >= 1.0) {
            throw heap TsException("Split: testFraction must be in (0, 1) "
                + "(got " + testFraction + ")");
        }
        int64 n = s.count();
        int64 nTest = (int64) (testFraction * (float64) n);
        if (nTest < 1) { nTest = 1; }
        int64 nTrain = n - nTest;
        if (nTrain < 1) {
            throw heap TsException("Split: testFraction " + testFraction
                + " leaves no training data (n = " + n + ")");
        }
        Series tr #= Split.slice(s, (int64) 0, nTrain);
        Series te #= Split.slice(s, nTrain, n);
        TrainTest tt = heap TrainTest(#tr, #te);
        return #tt;
    }

    /** Positions `[lo, hi)` as a fresh series with its original index. */
    static #Series slice(Series s, int64 lo, int64 hi) {
        int64 m = hi - lo;
        float64[] a = heap float64[m];
        int64[] idx = heap int64[m];
        int64 i = 0;
        while (i < m) {
            a[i] = s.get(lo + i);
            idx[i] = s.indexAt(lo + i);
            i = i + 1;
        }
        int64[] sh = heap int64[1]; sh[0] = m;
        return Series.of(Tensor.of<float64>(a, sh), idx);
    }
}
