package dev.cajeta.timeseries.tour;

import cajeta.math.Tensor;
import dev.cajeta.timeseries.Series;

/**
 * The self-checking tour of dev.cajeta.timeseries. Every passage
 * demonstrates a documented claim and CHECKS it — a non-zero exit means
 * the docs lied. Passages land unit by unit alongside the library.
 */
public final class Tour {

    static int32 failures;

    static void check(boolean ok, String what) {
        if (ok) {
            System.stdout.println("  ok  - " + what);
        } else {
            System.stdout.println("  FAIL- " + what);
            Tour.failures = Tour.failures + 1;
        }
        return;
    }

    /** Passage 1 — the Series type: lags shift, missing is explicit. */
    static void seriesPassage() {
        System.stdout.println("passage: series and lags");
        float64[] a = heap float64[5];
        a[0] = 1.0; a[1] = 2.0; a[2] = 3.0; a[3] = 4.0; a[4] = 5.0;
        int64[] sh = heap int64[1]; sh[0] = 5;
        Series s = Series.of(Tensor.of<float64>(a, sh));
        Series l = s.lag((int64) 1);
        Tour.check(l.isMissing((int64) 0), "lag(1) marks the head missing, not zero");
        Tour.check(l.get((int64) 1) == 1.0, "lag(1) aligns y(t-1) under t");
        Tour.check(l.dropMissing().count() == (int64) 4,
            "dropMissing() accounts for the shortened length explicitly");
        return;
    }

    public static int32 main() {
        Tour.failures = 0;
        System.stdout.println("== dev.cajeta.timeseries tour ==");
        Tour.seriesPassage();
        if (Tour.failures > 0) {
            System.stdout.println("TOUR FAILED: " + Tour.failures + " check(s)");
            return 1;
        }
        System.stdout.println("tour complete: all checks passed");
        return 0;
    }
}
