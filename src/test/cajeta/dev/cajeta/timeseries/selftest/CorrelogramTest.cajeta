package dev.cajeta.timeseries.selftest;

import dev.cajeta.unit.Assert;
import cajeta.math.Tensor;
import dev.cajeta.timeseries.Acf;
import dev.cajeta.timeseries.AcfResult;
import dev.cajeta.timeseries.Pacf;
import dev.cajeta.timeseries.Series;

/**
 * ml-timeseries U5 — correlograms against statsmodels 0.14.6: ACF values
 * biased/adjusted (5.1.1, 5.1.4), Bartlett vs constant confidence bands
 * (5.1.2–5.1.3), the FFT path agreeing with the direct path (5.1.5),
 * PACF by all three method families (5.1.6), and the AR(2)/MA(2)
 * identification property (5.1.7).
 */
public class CorrelogramTest {

    public CorrelogramTest() { return; }

    // 5.1.1 + 5.1.2 + 5.1.3 — values and Bartlett confint match `acf`
    // exactly; the band WIDENS with lag; lag 0 is exactly 1.
    @Test
    public void acfValuesAndBartlettBandMatch() {
        Series ar1 #= Series.of(Fx.load("ts_diag_ar1"));
        AcfResult r #= Acf.compute(ar1, (int64) 20);
        Assert.isTrue(r.value((int64) 0) == 1.0);
        Tensor<float64> want #= Fx.load("ts_acf_ar1");
        Tensor<float64> ci #= Fx.load("ts_acf_ar1_confint");
        int64 k = 0;
        while (k <= 20) {
            Assert.isTrue(Fx.close(r.value(k), want.flatGet(k), 0.0000000001));
            Assert.isTrue(Fx.close(r.confLow(k), ci.flatGet(k * 2), 0.000000001));
            Assert.isTrue(Fx.close(r.confHigh(k), ci.flatGet(k * 2 + 1), 0.000000001));
            k = k + 1;
        }
        // Bartlett: the interval grows with lag on an autocorrelated series.
        Assert.isTrue(r.interval((int64) 10) > r.interval((int64) 1));

        // The constant band does not.
        AcfResult rc #= Acf.compute(ar1, (int64) 20, false, false, false, 0.05);
        Tensor<float64> cic #= Fx.load("ts_acf_ar1_confint_const");
        k = 0;
        while (k <= 20) {
            Assert.isTrue(Fx.close(rc.confLow(k), cic.flatGet(k * 2), 0.000000001));
            Assert.isTrue(Fx.close(rc.confHigh(k), cic.flatGet(k * 2 + 1), 0.000000001));
            k = k + 1;
        }
        Assert.isTrue(Fx.close(rc.interval((int64) 10), rc.interval((int64) 1), 0.000000000001));
        return;
    }

    // 5.1.4 — the adjusted estimator (n−k denominators) matches.
    @Test
    public void adjustedEstimatorMatches() {
        Series ar1 #= Series.of(Fx.load("ts_diag_ar1"));
        AcfResult r #= Acf.compute(ar1, (int64) 20, true, false, true, 0.05);
        Tensor<float64> want #= Fx.load("ts_acf_ar1_adj");
        int64 k = 0;
        while (k <= 20) {
            Assert.isTrue(Fx.close(r.value(k), want.flatGet(k), 0.0000000001));
            k = k + 1;
        }
        return;
    }

    // 5.1.5 — the FFT path gives the same correlogram as the direct path
    // (float32 transform precision; the assertion that makes the
    // optimization safe).
    @Test
    public void fftPathAgreesWithDirect() {
        Series ar1 #= Series.of(Fx.load("ts_diag_ar1"));
        AcfResult direct #= Acf.compute(ar1, (int64) 20);
        AcfResult viaFft #= Acf.compute(ar1, (int64) 20, false, true, true, 0.05);
        int64 k = 0;
        while (k <= 20) {
            Assert.isTrue(Fx.close(viaFft.value(k), direct.value(k), 0.0001));
            k = k + 1;
        }
        return;
    }

    // 5.1.6 — PACF by Yule-Walker (ywm and adjusted), OLS, and
    // Levinson-Durbin all match statsmodels.
    @Test
    public void pacfMethodsMatch() {
        Series ar1 #= Series.of(Fx.load("ts_diag_ar1"));
        AcfResult ywm #= Pacf.compute(ar1, (int64) 20);
        AcfResult ywa #= Pacf.compute(ar1, (int64) 20, "ywadjusted");
        AcfResult ols #= Pacf.compute(ar1, (int64) 20, "ols");
        AcfResult ldb #= Pacf.compute(ar1, (int64) 20, "ldb");
        Tensor<float64> wYwm #= Fx.load("ts_pacf_ar1_ywm");
        Tensor<float64> wYwa #= Fx.load("ts_pacf_ar1_ywa");
        Tensor<float64> wOls #= Fx.load("ts_pacf_ar1_ols");
        Tensor<float64> wLdb #= Fx.load("ts_pacf_ar1_ldb");
        int64 k = 0;
        while (k <= 20) {
            Assert.isTrue(Fx.close(ywm.value(k), wYwm.flatGet(k), 0.0000000001));
            Assert.isTrue(Fx.close(ywa.value(k), wYwa.flatGet(k), 0.0000000001));
            Assert.isTrue(Fx.close(ols.value(k), wOls.flatGet(k), 0.000000001));
            Assert.isTrue(Fx.close(ldb.value(k), wLdb.flatGet(k), 0.0000000001));
            k = k + 1;
        }
        // ywm and ldb are the same estimator through different algebra.
        k = 0;
        while (k <= 20) {
            Assert.isTrue(Fx.close(ywm.value(k), ldb.value(k), 0.000000000001));
            k = k + 1;
        }
        return;
    }

    // 5.1.7 + §6.8 — identification: a known AR(2) has PACF cutting off
    // after lag 2, a known MA(2) has ACF cutting off after lag 2, and
    // lastSignificantLag() reads the order off the correlogram.
    @Test
    public void arMaIdentification() {
        Series ar2 #= Series.of(Fx.load("ts_ident_ar2"));
        AcfResult p #= Pacf.compute(ar2, (int64) 6);
        Assert.isTrue(p.significant((int64) 1));
        Assert.isTrue(p.significant((int64) 2));
        Assert.isTrue(!p.significant((int64) 3));
        Assert.equals(p.lastSignificantLag(), (int64) 2);   // suggests p = 2

        Series ma2 #= Series.of(Fx.load("ts_ident_ma2"));
        AcfResult a #= Acf.compute(ma2, (int64) 6);
        Assert.isTrue(a.significant((int64) 1));
        Assert.isTrue(a.significant((int64) 2));
        Assert.isTrue(!a.significant((int64) 3));
        Assert.equals(a.lastSignificantLag(), (int64) 2);   // suggests q = 2
        return;
    }
}
